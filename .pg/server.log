2026-10-19 21:38:59.855 IST [27645] STATEMENT:  
	SELECT p.label, s.window_label, m.band, m.channel, m.rssi_dbm, m.bssid,
	       round(m.dl_mbps::numeric,1) dl, round(m.ul_mbps::numeric,1) ul,
	       round(m.channel_util_pct,0) util, round(m.latency_ratio,1) ratio
	FROM measurements m
	JOIN reference_points p ON p.id=m.ref_point_id
	JOIN sessions s ON s.id=m.session_id
	LEFT JOIN bss_load b ON b.measurement_id=m.id AND b.phase='pre'
	ORDER BY p.label, s.window_label;
